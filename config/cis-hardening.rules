# /etc/audit/rules.d/cis-hardening.rules - System Audit Rules
# Author: Jacob John

# 1. Identity & Credential File Monitoring
-w /etc/group -p wa -k identity
-w /etc/passwd -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/security/opasswd -p wa -k identity

# 2. Sudoers & Privilege Escalation File Modifications
-w /etc/sudoers -p wa -k privilege_mod
-w /etc/sudoers.d/ -p wa -k privilege_mod

# 3. System Environment & Network Config Modifications
-w /etc/issue -p wa -k system-locale
-w /etc/issue.net -p wa -k system-locale
-w /etc/hosts -p wa -k system-locale
-w /etc/network/ -p wa -k system-locale

# 4. Mandatory Access Control & Security Logging
-w /var/log/faillog -p wa -k login-logs
-w /var/log/lastlog -p wa -k login-logs
-w /var/log/tallylog -p wa -k login-logs
